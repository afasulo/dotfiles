# Managed by chezmoi (github.com/afasulo/dotfiles). Edit with `chezmoi edit ~/.zshrc`.
# Machine-specific config goes in ~/.zshrc.local, secrets in ~/.secrets.
# Neither file is tracked, and both are loaded at the end of this file.

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

plugins=(
  git
  colored-man-pages
  zsh-autosuggestions
  sudo
{{- if eq .chezmoi.os "darwin" }}
  macos
{{- end }}
  zsh-syntax-highlighting
  colorize
  z
)

source "$ZSH/oh-my-zsh.sh"

command -v nvim >/dev/null && alias vim="nvim"

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# --- Toolchains (each only loads if installed) -------------------------------
typeset -U path
[[ -d "$HOME/.local/bin" ]] && path=("$HOME/.local/bin" $path)  # uv, uv tools, chezmoi
[[ -f "$HOME/.ghcup/env" ]] && . "$HOME/.ghcup/env"           # Haskell ghcup
{{- if eq .chezmoi.os "darwin" }}

[[ -e "$HOME/.iterm2_shell_integration.zsh" ]] && source "$HOME/.iterm2_shell_integration.zsh"

# 010 Editor CLI
[[ -d "/Applications/010 Editor.app/Contents/CmdLine" ]] && export PATH="$PATH:/Applications/010 Editor.app/Contents/CmdLine"

# Java: prefer Zulu 23 if present, otherwise the system default JDK.
if [[ -d /Library/Java/JavaVirtualMachines/zulu-23.jdk ]]; then
  export JAVA_HOME="/Library/Java/JavaVirtualMachines/zulu-23.jdk/Contents/Home"
elif /usr/libexec/java_home >/dev/null 2>&1; then
  export JAVA_HOME="$(/usr/libexec/java_home)"
fi
{{- end }}
[[ -n "$JAVA_HOME" ]] && export PATH="$JAVA_HOME/bin:$PATH"

# --- Local, untracked overrides (keep these last) ----------------------------
[[ -f ~/.secrets ]] && source ~/.secrets
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
