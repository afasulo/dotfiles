#!/usr/bin/env bash
# Installs packages for the sets enabled on this machine.
# chezmoi re-runs this whenever its rendered content changes (i.e. when
# .chezmoidata/packages.yaml or this machine's package choices change).
set -uo pipefail

{{- $sets := list "core" }}
{{- if .pkg_security }}{{ $sets = append $sets "security" }}{{ end }}
{{- if .pkg_hardware }}{{ $sets = append $sets "hardware" }}{{ end }}
{{- if .pkg_langs }}{{ $sets = append $sets "langs" }}{{ end }}
{{- $brew := list }}{{ $cask := list }}{{ $apt := list }}{{ $dnf := list }}{{ $script := list }}{{ $uvTool := list }}
{{- range $sets }}
{{-   $s := index $.packages . }}
{{-   $brew = concat $brew (dig "brew" (list) $s) }}
{{-   $cask = concat $cask (dig "cask" (list) $s) }}
{{-   $apt = concat $apt (dig "apt" (list) $s) }}
{{-   $dnf = concat $dnf (dig "dnf" (list) $s) }}
{{-   $script = concat $script (dig "script" (list) $s) }}
{{-   $uvTool = concat $uvTool (dig "uv_tool" (list) $s) }}
{{- end }}

# Package sets on this machine: {{ $sets | join ", " }}

log()  { printf '\033[1;34m[dotfiles]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[dotfiles] WARN:\033[0m %s\n' "$*" >&2; }

SUDO=""
if [ "$(id -u)" -ne 0 ]; then SUDO="sudo"; fi

{{ if eq .chezmoi.os "darwin" -}}
# ---------------------------------------------------------------- macOS
if ! command -v brew >/dev/null 2>&1; then
  for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    [ -x "$b" ] && eval "$("$b" shellenv)" && break
  done
fi
if ! command -v brew >/dev/null 2>&1; then
  log "Installing Homebrew"
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null || /usr/local/bin/brew shellenv)"
fi

log "brew bundle ({{ $sets | join ", " }})"
brew bundle --no-upgrade --file=- <<'BREWFILE' || warn "some brew packages failed; see output above"
{{- range $brew | uniq }}
brew {{ . | quote }}
{{- end }}
{{- range $cask | uniq }}
cask {{ . | quote }}
{{- end }}
BREWFILE

{{ else if eq .chezmoi.os "linux" -}}
# ---------------------------------------------------------------- Linux
{{-   $id := dig "id" "" .chezmoi.osRelease }}
{{-   $like := dig "idLike" "" .chezmoi.osRelease }}
{{-   if or (eq $id "debian" "ubuntu") (contains "debian" $like) (contains "ubuntu" $like) }}
log "apt: updating package index"
$SUDO apt-get update -qq
want=({{ $apt | uniq | join " " }})
have=()
for p in "${want[@]}"; do
  if apt-cache show "$p" >/dev/null 2>&1; then have+=("$p"); else warn "apt: '$p' not available on this distro, skipping"; fi
done
log "apt: installing ${have[*]}"
DEBIAN_FRONTEND=noninteractive $SUDO apt-get install -y -qq -o Dpkg::Use-Pty=0 --no-install-recommends "${have[@]}" ca-certificates \
  || warn "apt install reported errors"
{{-   else if or (eq $id "fedora" "rhel" "centos" "rocky" "almalinux") (contains "fedora" $like) (contains "rhel" $like) }}
{{-     if ne $id "fedora" }}
# RHEL-family needs EPEL for neovim, tmux extras, gh, etc.
$SUDO dnf install -y -q epel-release >/dev/null 2>&1 || true
{{-     end }}
want=({{ $dnf | uniq | join " " }})
have=()
for p in "${want[@]}"; do
  if rpm -q --whatprovides "$p" >/dev/null 2>&1 || dnf -q repoquery --whatprovides "$p" 2>/dev/null | grep -q .; then have+=("$p"); else warn "dnf: '$p' not available on this distro, skipping"; fi
done
log "dnf: installing ${have[*]}"
$SUDO dnf install -y -q "${have[@]}" || warn "dnf install reported errors"
{{-   else }}
warn "Unsupported Linux distro '{{ $id }}'; skipping system packages."
{{-   end }}
{{-   if .pkg_hardware }}
warn "Hardware set (librealsense, tracy) is macOS-only here; install manually on Linux."
{{-   end }}
{{-   if .pkg_security }}
command -v ghidra >/dev/null 2>&1 || warn "Ghidra isn't packaged for Linux; download from https://ghidra-sre.org if needed."
{{-   end }}
{{ end -}}

# ---------------------------------------------------------------- Cross-platform installers
{{- if has "uv" $script }}
if ! command -v uv >/dev/null 2>&1 && [ ! -x "$HOME/.local/bin/uv" ]; then
  log "Installing uv"
  curl -LsSf https://astral.sh/uv/install.sh | env UV_NO_MODIFY_PATH=1 sh
fi
{{- end }}
export PATH="$HOME/.local/bin:$PATH"
{{- range $uvTool | uniq }}
{{-   if ne $.chezmoi.os "darwin" }}
command -v {{ . }} >/dev/null 2>&1 || { log "uv tool install {{ . }}"; uv tool install {{ . }} || warn "uv tool install {{ . }} failed"; }
{{-   end }}
{{- end }}
{{- if has "ghcup" $script }}
if [ ! -x "$HOME/.ghcup/bin/ghcup" ]; then
  log "Installing ghcup (Haskell); this takes a while"
  curl --proto '=https' --tlsv1.2 -sSf https://get-ghcup.haskell.org \
    | BOOTSTRAP_HASKELL_NONINTERACTIVE=1 BOOTSTRAP_HASKELL_ADJUST_BASHRC=0 sh \
    || warn "ghcup install failed"
fi
{{- end }}

log "Packages done."
exit 0
